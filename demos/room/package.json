{
  "name": "kevins-ramen-boba-room",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../../scripts/sync-shop-from-boplog.mjs || echo '[prebuild] boplog sync skipped — using committed snapshot'",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "capture": "node tools/capture.mjs",
    "capture:placement": "node tools/capture.mjs --placement",
    "capture:chrome": "node tools/capture.mjs --chrome",
    "capture:full": "node tools/capture.mjs --beauty --placement",
    "capture:product": "node tools/capture.mjs --beauty --placement --chrome",
    "capture:behance": "node tools/capture-behance.mjs --build",
    "capture:photosphere": "node tools/capture-photosphere.mjs --build --label ramen-hq --size 1024",
    "capture:photosphere:4d": "node tools/capture-photosphere.mjs --build --label ramen-hq --size 1024 --frames 12 --fps 24",
    "sync:boplog": "node ../../scripts/sync-shop-from-boplog.mjs",
    "verify": "npm run sync:boplog && npm run build && node tools/capture.mjs --label verify --beauty --placement",
    "img2threejs:probe": "python3 ../../../../img2threejs/forge/stage1_intake/probe_image.py public/assets/ramen.jpg"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "@react-three/postprocessing": "^3.0.4",
    "postprocessing": "^6.39.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
